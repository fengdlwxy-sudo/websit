# 依赖（体积大，不入库）
node_modules/
node_modules - 副本/

# 运行日志 / 进程文件
server.log
server.pid

# 环境变量（含密码等敏感信息）
.env

# WorkBuddy 工作日志可能包含调试过程中的临时令牌/敏感信息，不提交
.workbuddy/memory/

# 用户上传的图片：必须入库！否则部署强推会把远程 uploads 目录清空，导致前台文章图片 404。
# pages-deploy.ps1 已在推送前把远程新增图片补回本地（本地优先），避免任何一方图片丢失。
assets/images/uploads/.gitkeep

# 系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.swp
