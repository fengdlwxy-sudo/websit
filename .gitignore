# 依赖（体积大，不入库）
node_modules/
node_modules - 副本/

# 运行日志 / 进程文件
server.log
server.pid

# 环境变量（含密码等敏感信息）
.env

# WorkBuddy 工作目录(含调试临时令牌/敏感信息/内部记忆)，绝不入库
.workbuddy/

# 用户上传的图片：必须入库！否则部署强推会把远程 uploads 目录清空，导致前台文章图片 404。
# pages-deploy.ps1 已在推送前把远程 data/ 与 uploads 原样还原，绝不拿本地过期文件覆盖。
assets/images/uploads/.gitkeep

# 本地缓存的部署 token（明文，仅本机使用，绝不入库）
.deploy-token

# 系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.swp
